@using KMS.Web.Common
@using KMS.Web.Common.Lang
@using KMS.Web.Core
@using KMS.Web.ViewModels.Shared.Components.Home
@using KMS.Web.Helpers
@using KMS.Web.ViewModels
@model DocumentDetailViewModel
@using KMS.Web.ViewModels.Shared.Components.DocumentDetail
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
	ViewData["Title"] = "Tra cứu Opac";
	Layout = "~/Pages/Shared/_LayoutPublish.cshtml";
}

@section styles {
	<link rel="stylesheet" href="@ConstLocation.value/public/css/@Manifest.get("document-detail.css.js")" />
}

@await Html.PartialAsync("SearchBar/_SearchBarHeaderWrapper")

<div class="second-content">
	@await Html.PartialAsync("DocumentDetail/_InfoContainer", Model.Document)
	@await Html.PartialAsync("DocumentDetail/_LibraryDocument", Model)
</div>
<div id="scrollToTopBtn" class="scrollToTopBtn">@Html.TopSite(false)</div>

@* @await Html.PartialAsync("FixedCornerButtons/_FixedCornerButtons")
 *@
@section scripts {
	<script>
		var iconBorrowing = `@Html.ReadSvg(false)`;
		var ConstLocation = `@ConstLocation.value`;
		var BtnBorrow = `@Localizer["DocumentDetail/_Accordions.buttons__borrow_MuonSach"]`;
	</script>
	<script src="@ConstLocation.value/public/js/@Manifest.get("document-detail.js")"></script>
}