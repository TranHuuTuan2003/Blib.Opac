@using KMS.Web.Common
@using KMS.Web.ViewModels.Shared.Components.Home
@using KMS.Web.Helpers
@using KMS.Web.ViewModels

@{
	ViewData["Title"] = "Mượn tài liệu";
	Layout = "~/Pages/Shared/_LayoutPublish.cshtml";
}

@section styles {
	<link rel="stylesheet" href="@ConstLocation.value/css/pages/document-borrow/style.css" asp-append-version="true" />
}

@await Html.PartialAsync("SearchBar/_SearchBarHeaderWrapper")

<div class="second-content">
    <div class="first-documentDetail__container first-documentDetail__max-with-1000">
        <div class="first-documentDetail__card first-documentDetail__left-card">

            <div class="first-documentDetail__title-with-line">
                <p class="first-documentDetail__label-borrow">THÔNG TIN TÀI LIỆU</p>
                <div class="first-documentDetail__line2"></div>
            </div>

            <div class="first-documentDetail__image-wrapper">
                <img src="https://m.media-amazon.com/images/I/61kunq0o1CL._SL1493_.jpg" />
            </div>

            <div class="first-documentDetail__info-row">
                <span class="first-documentDetail__info-label">Tiêu đề:</span>
                <span class="first-documentDetail__info-value">Giải thưởng Sách Quốc gia – Hội tụ tinh hoa lan tỏa tri thức</span>
            </div>

            <div class="first-documentDetail__info-row">
                <span class="first-documentDetail__info-label">Nguồn:</span>
                <span class="first-documentDetail__info-value">Thư viện Yên Bái</span>
            </div>

            <div class="first-documentDetail__info-row">
                <span class="first-documentDetail__info-label">Tiền cược:</span>
                <span class="first-documentDetail__info-value first-documentDetail__info-value red">0 VNĐ</span>
            </div>

        </div>

        <form class="first-documentDetail__card first-documentDetail__right-card" autocomplete="off" novalidate>

            <div class="first-documentDetail__title-with-line mb-1">
                <p class="first-documentDetail__label-borrow">THÔNG TIN ĐĂNG KÝ</p>
                <div class="first-documentDetail__line2"></div>
            </div>

            <div class="first-documentDetail__form-group">
                <label class="first-documentDetail__label" for="fullname">Họ và tên <span style="color:#9b1212">*</span></label>
                <input class="first-documentDetail__input" type="text" id="fullname" placeholder="Nhập họ và tên...." />
            </div>

            <div class="first-documentDetail__form-group" style="align-items: center;">
                <label class="first-documentDetail__label">Giới tính</label>
                <div class="first-documentDetail__radio-group">
                    <label class="first-documentDetail__radio-label">
                        <input type="radio" name="gender" value="Nam"/> Nam
                    </label>
                    <label class="first-documentDetail__radio-label">
                        <input type="radio" name="gender" value="Nữ" /> Nữ
                    </label>
                </div>
            </div>

            <div class="first-documentDetail__form-group">
                <label class="first-documentDetail__label" for="dob">Ngày sinh <span style="color:#9b1212">*</span></label>
                <input class="first-documentDetail__input" type="text" id="dob" placeholder="Nhập ngày/tháng/năm" />
            </div>

            <div class="first-documentDetail__form-group">
                <label class="first-documentDetail__label" for="idcard">CMND/CCCD <span style="color:#9b1212">*</span></label>
                <input class="first-documentDetail__input" type="text" id="idcard" placeholder="Nhập số CMND/CCCD" />
            </div>

            <div class="first-documentDetail__form-group">
                <label class="first-documentDetail__label" for="email">Email <span style="color:#9b1212">*</span></label>
                <input class="first-documentDetail__input" type="email" id="email" placeholder="Nhập email" />
            </div>

            <div class="first-documentDetail__form-group">
                <label class="first-documentDetail__label" for="phone">Điện thoại <span style="color:#9b1212">*</span></label>
                <input class="first-documentDetail__input" type="tel" id="phone" placeholder="Nhập điện thoại" />
            </div>

            <div class="first-documentDetail__form-group">
                <label class="first-documentDetail__label" for="time">Thời gian lấy <span style="color:#9b1212">*</span></label>
                <input class="first-documentDetail__input" type="text" id="time" placeholder="Nhập ngày/tháng/năm" />
            </div>

            <canvas class="first-documentDetail__captcha" id="captcha" width="160" height="70"
                    onclick="generateCaptcha()"></canvas>

            <div class="first-documentDetail__captcha-row">
                <input class="first-documentDetail__input" type="text" placeholder="Nhập mã xác thực" />
            </div>

            <p class="first-documentDetail__note">
                Với việc nhấn vào ô đăng ký bên dưới, bạn cam kết chịu trách nhiệm về những thông tin mình cung cấp
            </p>

            <div class="first-documentDetail__buttons">
                <button type="reset" class="first-documentDetail__reset"><i class="fas fa-sync-alt"></i> Làm mới</button>
                <button type="submit" class="first-documentDetail__submit"><i class="fas fa-sign-in-alt"></i> Đăng ký</button>
            </div>

        </form>
    </div>
</div>


@section scripts {
    <script src="@ConstLocation.value/public/js/@Manifest.get("document-borrow.js")"></script>
}