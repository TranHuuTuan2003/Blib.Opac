@using KMS.Web.Common
@using KMS.Web.Common.Lang
@using KMS.Web.ViewModels.Shared.Components.Home
@using KMS.Web.Models.JsonConfig
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer
@model HomeViewModel

@{
	ViewData["Title"] = "Tra cứu Opac";
	Layout = "~/Pages/Shared/_LayoutPublish.cshtml";
}

@section styles {
	<link rel="stylesheet" href="@ConstLocation.value/css/pages/home/style.css" asp-append-version="true"  />
}

@await Html.PartialAsync("SearchBar/_SearchBarHeaderWrapper")

<div class="first-home-section">
	<section class="header--lining"></section>
	<div class="first-home-section__title custom-container">
		<label class="first-home-section__titleTop">Knowledge Management System</label>
		<label class="first-home-section__titleSub">@Localizer["Home/Index.first-home-section__titleSub_CaTheGioDangONgayTrongTamTayBan"]</label>
		@await Html.PartialAsync("SearchBar/_SearchBar")
	</div>
</div>

@await Html.PartialAsync("Home/_CollectionDocument", Model.Collections)

<div class="home__statistics-section-wrapper custom-container">
	<div class="home__statistics-section">
		<div class="statistics-section__content-block">
			<p class="statistics-section__first-title">@Localizer["Home/Insex.statistics-section__first-title_ThuVienSo"]</p>
			<p class="statistics-section__second-title">@Localizer["Home/Insex.statistics-section__second-title_SucManhTuNhungConSo"]</p>
			<p class="statistics-section__description">
				@Localizer["Home/_DocumentNew.documet__subtitle_ChungToiDongHanh"]
			</p>
		</div>
		<div class="statistics-section__main-block">
			<div class="statistics-section__statistics-item">
				<p class="statistics-section__number" data-target="8000"></p>
				<p class="statistics-section__unit">@Localizer["Home/Insex.statistics-section__unit_NguoiDung"]</p>
			</div>
			<div class="statistics-section__statistics-item">
				<p class="statistics-section__number" data-target="200000"></p>
				<p class="statistics-section__unit">@Localizer["Home/Insex.statistics-section__unit_TaiLieuIn"]</p>
			</div>
			<div class="statistics-section__statistics-item">
				<p class="statistics-section__number" data-target="400000"></p>
				<p class="statistics-section__unit">@Localizer["Home/Insex.statistics-section__unit_LuotTraCuu"]</p>
			</div>
			<div class="statistics-section__statistics-item">
				<p class="statistics-section__number" data-target="100000"></p>
				<p class="statistics-section__unit">@Localizer["Home/Insex.statistics-section__unit_TaiLieuSo"]</p>
			</div>
		</div>
		<img class="statistics-section__dots-bottom" src="@ConstLocation.value/img/home/dots.svg" asp-append-version="true" />
	</div>
</div>
	
@await Html.PartialAsync("Home/_DocumentNew",Model.DocumentNews)
@await Html.PartialAsync("Home/_ContacAbum", null)
@await Html.PartialAsync("FixedCornerButtons/_FixedCornerButtons")
@section scripts {
	<script src="@ConstLocation.value/public/js/@Manifest.get("home.js")"></script>
}