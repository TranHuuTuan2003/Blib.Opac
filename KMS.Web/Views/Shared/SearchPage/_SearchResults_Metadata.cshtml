@using KMS.Web.Common
@using KMS.Web.ViewModels.Shared.Components.SearchPage
@model SearchResultViewModel
@using KMS.Web.Common.Lang
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

<div class="search-page__result-header">
	<div class="search-page__result-header-filter">
		@SvgHelper.GetSvgIcon("filter", true)
		<label>@Localizer["SearchPage/_SearchResults_Metadata.search-page__result-header-filter_BoLoc"]</label>
	</div>

	<div class="search-page__result-header-left">
		<p class="search-page__result-title">@Localizer["SearchPage/_SearchResults_Metadata.search-page__result-title_KetQua"]</p>
		@if (Model == null || Model.results == null || !Model.results.Any())
		{
			<p class="search-page__no-result-header-text">@Localizer["SearchPage/_SearchResults_Metadata.search-page__no-result-header-text_KoTimThayKetQua"]</p>
		}
		else
		{
			var result_from = (Model.currentPage - 1) * Model.pageSize + 1;
			var result_to = Math.Min(Model.currentPage * Model.pageSize, Model.totalRecords);

			<p class="search-page__no-result-header-text">
				@Localizer["SearchPage/_SearchResults_Metadata.search-page__no-result-header-text_TimThay"] <b> @result_from.ToString("N0")-@result_to.ToString("N0") </b> @Localizer["SearchPage/_SearchResults_Metadata.search-page__no-result-header-text_Trong"]
				@Model.totalRecords.ToString("N0")
			</p>
		}
	</div>

	<div class="search-page__result-header-right">
		<label class="search-page__filter-label">@Localizer["SearchPage/_SearchResults_Metadata.search-page__filter-label_SapXep"]</label>
		<div class="search-sort dropdown">
			<button class="search-sort__button btn btn-light dropdown-toggle p-0 border-0 shadow-none" type="button"
					id="searchSortDropdown" data-bs-toggle="dropdown" aria-expanded="false">
				@(Model.sortType.EndsWith("asc", StringComparison.OrdinalIgnoreCase) ? @Localizer["SearchPage/_SearchResults_Metadata.search-sort__button_GiamDanTheoNamXuatBan"] :
								@Localizer["SearchPage/_SearchResults_Metadata.search-sort__button_TangDanTheoNamXuatBan"])
			</button>
			<ul class="search-sort__menu dropdown-menu w-100" aria-labelledby="searchSortDropdown">
				<li>
					<a class="dropdown-item search-sort__sort-type cursor-pointer" data-sort="desc">
						@Localizer["SearchPage/_SearchResults_Metadata.search-sort__button_GiamDanTheoNamXuatBan"]
					</a>
				</li>
				<li>
					<a class="dropdown-item search-sort__sort-type cursor-pointer" data-sort="asc">
						@Localizer["SearchPage/_SearchResults_Metadata.search-sort__button_TangDanTheoNamXuatBan"]
					</a>
				</li>
			</ul>
		</div>
	</div>

	<div class="search-page__result-header-horizontal-line"></div>
</div>