@using KMS.Web.Common
@using KMS.Web.Common.Lang
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

<style>
    .modal-login__overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.45);
        align-items: center;
        justify-content: center;
        z-index: 999;
    }

    .modal-login__overlay.active {
        display: flex;
    }

    .modal-login__container {
        background: #fff;
        width: 500px;
        padding: 32px;
        border-radius: 3px;
        box-shadow: 0 20px 50px rgba(0,0,0,.25);
        animation: zoomIn .25s ease;
    }

    @@keyframes zoomIn {
        from {
            transform: scale(.9);
            opacity: 0;
        }
        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    .modal-login__title {
        text-align: center;
        color: var(--primary-color);
        font-weight: 700;
        margin-bottom: 28px;
        font-size: 30px;
    }

    .modal-login__form-group {
        margin-bottom: 30px;
    }

    .modal-login__label {
        display: block;
        font-weight: 600;
        margin-bottom: 6px;
        color: #555;
        font-size: 16px;
    }

    .modal-login__input {
        width: 100%;
        padding: 12px 14px;
        border-radius: 10px;
        border: 1px solid #ddd;
        outline: none;
        font-size: 15px;
    }

    .modal-login__input:focus {
        border-color: #90caf9;
        box-shadow: 0 0 0 3px rgba(144,202,249,.4);
    }

    .modal-login__password-wrapper {
        position: relative;
    }

    .modal-login__eye {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        opacity: .6;
        user-select: none;
        font-size:24px;
    }

    .modal-login__btn {
        width: 100%;
        padding: 14px;
        border-radius: 3px;
        border: none;
        background: linear-gradient(90deg, #96bdff, var(--primary-color));
        color: #fff;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        margin-top: 12px;
    }

    .modal-login__btn:hover {
        opacity: .95;
    }
</style>

<div class="modal-login__overlay" id="loginModal">
    <div class="modal-login__container">
        <h2 class="modal-login__title">@Localizer["Login/_Login.toast.modal-login__title_DangNhap"]</h2>

        <div class="modal-login__form-group">
            <label class="modal-login__label">@Localizer["Login/_Login.toast.modal-login__label_TaiKhoan"]</label>
            <input class="modal-login__input" type="text" id="txtCardNo" placeholder="@Localizer["Login/_Login.toast.modal-login__input_NhapTaiKhoan"]">
        </div>

        <div class="modal-login__form-group">
            <label class="modal-login__label">@Localizer["Login/_Login.toast.modal-login__label_MatKhau"]</label>
            <div class="modal-login__password-wrapper">
                <input class="modal-login__input"
                       id="passwordInput"
                       type="password"
                       placeholder="@Localizer["Login/_Login.toast.modal-login__input_NhapMatKhau"]">
                <span id="togglePassword" class="modal-login__eye" style="cursor:pointer">
                    <svg style="width: 20px; fill: var(--primary-text);" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 512"><path d="M634 471L36 3.51A16 16 0 0 0 13.51 6l-10 12.49A16 16 0 0 0 6 41l598 467.49a16 16 0 0 0 22.49-2.49l10-12.49A16 16 0 0 0 634 471zM296.79 146.47l134.79 105.38C429.36 191.91 380.48 144 320 144a112.26 112.26 0 0 0-23.21 2.47zm46.42 219.07L208.42 260.16C210.65 320.09 259.53 368 320 368a113 113 0 0 0 23.21-2.46zM320 112c98.65 0 189.09 55 237.93 144a285.53 285.53 0 0 1-44 60.2l37.74 29.5a333.7 333.7 0 0 0 52.9-75.11 32.35 32.35 0 0 0 0-29.19C550.29 135.59 442.93 64 320 64c-36.7 0-71.71 7-104.63 18.81l46.41 36.29c18.94-4.3 38.34-7.1 58.22-7.1zm0 288c-98.65 0-189.08-55-237.93-144a285.47 285.47 0 0 1 44.05-60.19l-37.74-29.5a333.6 333.6 0 0 0-52.89 75.1 32.35 32.35 0 0 0 0 29.19C89.72 376.41 197.08 448 320 448c36.7 0 71.71-7.05 104.63-18.81l-46.41-36.28C359.28 397.2 339.89 400 320 400z" /></svg>
                </span>
            </div>
        </div>


        <button class="modal-login__btn" id="btnSubmitLogin">@Localizer["Login/_Login.toast.modal-login__btn_DangNhap"]</button>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const btnLogin = document.querySelector(".header__btnLogin");
        const modal = document.getElementById("loginModal");
        const modalContent = modal.querySelector(".modal-login__container");
        const togglePassword = document.getElementById("togglePassword");
        const passwordInput = document.getElementById("passwordInput");
        let OPAC_USER = null;

        btnLogin.addEventListener("click", function () {
            modal.classList.add("active");
        });

        modal.addEventListener("click", function () {
            modal.classList.remove("active");
        });

        modalContent.addEventListener("click", function (e) {
            e.stopPropagation();
        });

        const eyeClose = `
                <svg  style="width: 20px; fill: var(--primary-text);" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512"><path d="M288 144a110.94 110.94 0 0 0-31.24 5 55.4 55.4 0 0 1 7.24 27 56 56 0 0 1-56 56 55.4 55.4 0 0 1-27-7.24A111.71 111.71 0 1 0 288 144zm284.52 97.4C518.29 135.59 410.93 64 288 64S57.68 135.64 3.48 241.41a32.35 32.35 0 0 0 0 29.19C57.71 376.41 165.07 448 288 448s230.32-71.64 284.52-177.41a32.35 32.35 0 0 0 0-29.19zM288 400c-98.65 0-189.09-55-237.93-144C98.91 167 189.34 112 288 112s189.09 55 237.93 144C477.1 345 386.66 400 288 400z"/></svg>
        `;

        const eyeOpen = `
                <svg  style="width: 20px; fill: var(--primary-text);" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 512"><path d="M634 471L36 3.51A16 16 0 0 0 13.51 6l-10 12.49A16 16 0 0 0 6 41l598 467.49a16 16 0 0 0 22.49-2.49l10-12.49A16 16 0 0 0 634 471zM296.79 146.47l134.79 105.38C429.36 191.91 380.48 144 320 144a112.26 112.26 0 0 0-23.21 2.47zm46.42 219.07L208.42 260.16C210.65 320.09 259.53 368 320 368a113 113 0 0 0 23.21-2.46zM320 112c98.65 0 189.09 55 237.93 144a285.53 285.53 0 0 1-44 60.2l37.74 29.5a333.7 333.7 0 0 0 52.9-75.11 32.35 32.35 0 0 0 0-29.19C550.29 135.59 442.93 64 320 64c-36.7 0-71.71 7-104.63 18.81l46.41 36.29c18.94-4.3 38.34-7.1 58.22-7.1zm0 288c-98.65 0-189.08-55-237.93-144a285.47 285.47 0 0 1 44.05-60.19l-37.74-29.5a333.6 333.6 0 0 0-52.89 75.1 32.35 32.35 0 0 0 0 29.19C89.72 376.41 197.08 448 320 448c36.7 0 71.71-7.05 104.63-18.81l-46.41-36.28C359.28 397.2 339.89 400 320 400z"/></svg>
        `;

        togglePassword.addEventListener("click", () => {
            const isPassword = passwordInput.type === "password";

            passwordInput.type = isPassword ? "text" : "password";
            togglePassword.innerHTML = isPassword ? eyeClose : eyeOpen;

            passwordInput.focus();
            passwordInput.setSelectionRange(
                passwordInput.value.length,
                passwordInput.value.length
            );
        });

        //Đăng nhập
        const txtCardNo = document.getElementById("txtCardNo");
        const btnSubmit = document.getElementById("btnSubmitLogin");
        btnSubmit.addEventListener("click", async () => {
            const cardNo = txtCardNo.value.trim();
            const password = passwordInput.value.trim();

            try {
                const res = await fetch("@ConstLocation.value/proxy/app/api/Document/login-opac", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ cardNo, password })
                });

                const text = await res.text();
                let data = {};

                try {
                    data = text ? JSON.parse(text) : {};
                } catch (e) {
                    console.error("JSON parse error:", e);
                    alert("Dữ liệu trả về không hợp lệ");
                    return;
                }

                if (!res.ok || data.success === false) {
                    alert(data.message || "Đăng nhập thất bại");
                    return;
                }

                OPAC_USER = data.data ?? data; 
                localStorage.setItem("OPAC_USER", JSON.stringify(OPAC_USER));
                modal.classList.remove("active");

            } catch (err) {
                console.error(err);
                alert("Không thể kết nối máy chủ");
            }
        });


        const savedUser = localStorage.getItem("OPAC_USER");
        if (savedUser) {
            OPAC_USER = JSON.parse(savedUser);
            console.log("User from storage:", OPAC_USER);
        }

    });
</script>
