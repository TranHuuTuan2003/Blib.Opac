@using KMS.Web.Common
@using Microsoft.Extensions.Localization
@using KMS.Web.Common.Lang
@using KMS.Web.ViewModels.Shared.Components.SidebarMenu
@inject KMS.Web.Helpers.AuthHelper AuthHelper
@inject IStringLocalizer<SharedResource> Localizer
@model SidebarMenuViewModel

@{
    var tenantCode = Context.Items["Tenant"]?.ToString()?.ToLower() ?? "default";
    var avatarUrl = AuthHelper.GetAvatar();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentPath = ViewContext.HttpContext.Request.Path.Value?.Trim('/').ToLower() ?? "";
    var lang = AppConfigHelper.GetCurrentLanguage();
}

<link rel="stylesheet" href="@ConstLocation.value/css/components/sidebar-menu/style.css" asp-append-version="true">

<div class="sidebar-menu">
    <nav class="navbar_right">
        <ul>
            <li class="cursor-pointer">
                <a class="toggle-submenu" href="@ConstLocation.value/">@Localizer["Header/_heard.link-text_TrangChu"]</a>
            </li>
            <li class="cursor-pointer">
                <a class="toggle-submenu" href="@ConstLocation.value@Url.Action("Index", "Search")">@Localizer["Header/_heard.link-text_TimKiemTaiLieu"]</a>
            </li>
            <li class="cursor-pointer" >
                <a class="toggle-submenu" href="@ConstLocation.value@Url.Action("CollectionPdoc", "Search")">@Localizer["Header/_heard.link-text_TaiLieuIn"]</a>
            </li>
            <li class="cursor-pointer">
                <a class="toggle-submenu" href="@ConstLocation.value@Url.Action("CollectionDdoc", "Search")">@Localizer["Header/_heard.link-text_TaiLieuSo"]</a>
            </li>
            <li class="cursor-pointer d-flex flex-wrap">
                <a class="toggle-submenu toggleFilterBtn">
                    @Localizer["Header/_heard.link-text_ChuongTrinhDaoTao"]
                </a>

                <img src="@ConstLocation.value/img/icons/arrow-down.svg"
                     class="search-filter__arrow ms-auto toggleFilterBtn2">

                <div style="background-color:#f3f3f3;
                padding:10px;
                width:100%;
                margin-top:10px;
                display:none"
                     id="filterDropdownMobile">
                    Nội dung dropdown ở đây
                </div>
            </li>



            <li class="cursor-pointer">
                <a class="toggle-submenu">@Localizer["Header/_heard.link-text_LienHe"]</a>
            </li>
        </ul>
    </nav>
</div>
<div class="sidebar-menu__overlay"></div>

<script>
    const toggleBtn = document.querySelector(".toggleFilterBtn");
    const toggleBtn2 = document.querySelector(".toggleFilterBtn2");
    const dropdown = document.getElementById("filterDropdownMobile");

    toggleBtn.addEventListener("click", function () {
        if (dropdown.style.display === "none" || dropdown.style.display === "") {
            dropdown.style.display = "block";
        } else {
            dropdown.style.display = "none";
        }
    });

    toggleBtn2.addEventListener("click", function () {
        if (dropdown.style.display === "none" || dropdown.style.display === "") {
            dropdown.style.display = "block";
        } else {
            dropdown.style.display = "none";
        }
    });

    function getList() {
        fetch(`${BASE_URL}/proxy/app/api/TrainingProgram/get-list-training-program`, {
            method: "GET",
            headers: {
                "Content-Type": "application/json"
            }
        })
        .then(response => {
            if (!response.ok) {
                throw new Error("Network response was not ok");
            }
            return response.json();
        })
        .then(data => {
            if (data.success) {
                renderRegisterTableMobile(data.data);
            }
        })
        .catch(error => {
            console.error("Fetch error:", error);
        });
    }

    getList();

    function renderRegisterTableMobile(list) {
        const container = document.querySelector("#filterDropdownMobile");
        container.innerHTML = "";

        list.forEach(item => {
            const p = document.createElement("p");
            p.textContent = item.name;
            p.classList.add("sidebar-menu__mobile-item");
            p.addEventListener("click", function () {
                    handleTrainingClick(item.id);
                });
            container.appendChild(p);
        });
    }

    function handleTrainingClick(id) {
        const url = `${BASE_URL}/chuong-trinh-dao-tao/${id}`;
        window.location.href = url;
    }
</script>