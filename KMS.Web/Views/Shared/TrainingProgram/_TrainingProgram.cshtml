@using KMS.Shared.DTOs.TrainingProgram
@using KMS.Web.Common
@using KMS.Web.Common.Lang
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer
@model TrainingPrograms

<div class="training-program__container custom-container">
    <h1 class="training-program__title">@Model.DetailSystem[0].name - @Model.DetailSystem[0].code</h1>
    <h3 class="training-program__subtitle">
        Ngành @Model.DetailSystem[0].industry
    </h3>

    <p class="training-program__description">
        @Model.DetailSystem[0].description
    </p>

    <div class="training-program__version-bar">
        @* <span>Phiên bản:</span>
        <select>
            <option>K67 - 2025</option>
        </select> *@
        @* <button>Chia sẻ</button>
        <button>Thêm vào danh sách</button> *@
    </div>

    <table>
        <thead>
            <tr>
                <th colspan="2">@Localizer["TrainingProgram/_TrainingProgram.training-program__container.th_NoiDungVaKeHoach"]</th>
                <th style="width:150px" rowspan="2">@Localizer["TrainingProgram/_TrainingProgram.training-program__container.th_SoTinChi"]</th>
                <th colspan="2">@Localizer["TrainingProgram/_TrainingProgram.training-program__container.th_SoLuongHocLieu"]</th>
            </tr>
            <tr>
                <th style="width:60px">STT</th>
                <th style="width:55%">@Localizer["TrainingProgram/_TrainingProgram.training-program__container.th_MaHocPhan"]</th>
                <th style="width:150px">@Localizer["TrainingProgram/_TrainingProgram.training-program__container.th_HocLieu"]</th>
                <th style="width:150px">@Localizer["TrainingProgram/_TrainingProgram.training-program__container.th_TaiLieu"]</th>

            </tr>
        </thead>

        <tbody>
            <tr class="training-program__group">
                <td colspan="13">1. @Localizer["TrainingProgram/_TrainingProgram.training-program__group.td_HocPhanChung"]</td>
            </tr>

            @{
                var stt = 1;
            }
            @foreach (var item in Model.ListSectionTrue)
            {
                <tr>
                    <td>@stt</td>
                    <td class="training-program__code" style="cursor: pointer;"
                        onclick="window.open('@($"{ConstLocation.value}/chuong-trinh-dao-tao/chi-tiet/{item.id}")','_blank')">
                        @item.code - @item.name
                    </td>
                    <td>@item.no_of_cert</td>
                    <td>@item.subject_count</td>
                    <td>@item.subject_lib_count</td>
                </tr>
                stt++;
            }

            <tr class="training-program__group">
                <td colspan="13 ">1. @Localizer["TrainingProgram/_TrainingProgram.training-program__group.td_HocPhanRieng"] </td>
            </tr>

            @{
                var stt2 = 1;
            }
            @foreach (var item in Model.ListSectionFalse)
            {
                <tr>
                    <td>@stt2</td>
                    <td class="training-program__code" style="cursor: pointer;"
                        onclick="window.open('@($"{ConstLocation.value}/chuong-trinh-dao-tao/chi-tiet/{item.id}")','_blank')">
                        @item.code - @item.name
                    </td>
                    <td>@item.no_of_cert</td>
                    <td>@item.subject_count</td>
                    <td>@item.subject_lib_count</td>
                </tr>
                stt2++;
            }
        </tbody>
    </table>
</div>