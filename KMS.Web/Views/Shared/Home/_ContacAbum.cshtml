@using KMS.Web.Common
@using KMS.Web.ViewModels.Shared.Components.Home
@using KMS.Web.Common.Lang
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer
@model HomeViewModel

@{
    var baseUrlImage = AppConfigHelper.GetBaseUrlFile();
}

@functions {
	public string GetYoutubeEmbedUrl(string url)
	{
		if (string.IsNullOrEmpty(url))
			return string.Empty;

		if (url.Contains("youtu.be/"))
		{
			return "https://www.youtube.com/embed/" +
				   url.Split("youtu.be/")[1].Split('?')[0];
		}

		if (url.Contains("watch?v="))
		{
			return "https://www.youtube.com/embed/" +
				   url.Split("watch?v=")[1].Split('&')[0];
		}

		if (url.Contains("/shorts/"))
		{
			return "https://www.youtube.com/embed/" +
				   url.Split("/shorts/")[1].Split('?')[0];
		}

		return url;
	}
}

<div class="home__end-section">
	<div class="information-section__info-block-wrapper" id="information-section__info-block-wrapper">
		<div class="information-section__info-block">
			<div class=" information-section__text-block">
				<div class="information-section__content-block">
					<p class="information-section__content-title">
						@Localizer["Home/_ContactAbum.information-section__content-title_KhamPhaTriThuc"] <br>
						@Localizer["Home/_ContactAbum.information-section__content-title_BatDauHanhTrinh"]
					</p>
					<p class="information-section_content-description">
						@Localizer["Home/_ContactAbum.information-section_content-description_TaiHeThongTra"]
					</p>
				</div>

				<div class="information-section__contact-block">
					<div class="information-section__contact-title-block">
						<p class="information-section__contact-title">@Localizer["Home/_ContactAbum.information-section__contact-title_KetNoiVoiChungtoi"]</p>
						<div class="information-section__contact-line"></div>
					</div>
					<div class="information-section__contact-items"
						 onclick="openMap('@Model.ContactInformation.Address')">
						<p class="information-section__contact-info">
							@Model.ContactInformation.Address
						</p>
						<svg class="information-section__arrow" width="24" height="24" viewBox="0 0 24 24"
							 fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor">
							<path d="M5 12h14M13 5l7 7-7 7"
								  stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</div>

					<div class="information-section__contact-items"
						 onclick="callPhone('@Model.ContactInformation.PhoneNumber')">
						<p class="information-section__contact-info">
							@Model.ContactInformation.PhoneNumber
						</p>
						<svg class="information-section__arrow" width="24" height="24" viewBox="0 0 24 24"
							 fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor">
							<path d="M5 12h14M13 5l7 7-7 7"
								  stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</div>

					<div class="information-section__contact-items"
						 onclick="sendEmail('@Model.ContactInformation.Email')">
						<p class="information-section__contact-info">
							@Model.ContactInformation.Email
						</p>
						<svg class="information-section__arrow" width="24" height="24" viewBox="0 0 24 24"
							 fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor">
							<path d="M5 12h14M13 5l7 7-7 7"
								  stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</div>

				</div>
			</div>
			<div class=" information-section__media-block">
				<div class="information-section__media-title-block">
					<p class="information-section__media-title">@Localizer["Home/_ContactAbum.information-section__media-title_KhongGianHinhAnh"]</p>
					<div class="information-section__media-line"></div>

				</div>
				<div class="information-section__media-items">
					@foreach (var item in Model.MediaItems)
					{
						@if (item.IsVideo)
						{
							@* <div class="information-section__media-item">
								<iframe class="information-section__item-video" style="height:100%"
										src="@GetYoutubeEmbedUrl(item.Url)"
										frameborder="0"
										allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
										allowfullscreen>
								</iframe>
							</div> *@
						}

						else
						{
							<div class="information-section__media-item">
								<a href="@item.Url"
								   data-lightbox="gallery"
								   target="_blank"
								   rel="noopener noreferrer">
									<img data-src="@item.Url"
										 class="information-section__item-image"
										 asp-append-version="true" />
								</a>
							</div>
						}
					}
				</div>
			</div>
		</div>
	</div>

</div>

<script>
	function openMap(address) {
		const url = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;
		window.open(url, '_blank');
	}

	function callPhone(phone) {
		window.location.href = `tel:${phone.replace(/\s+/g, '')}`;
	}

	function sendEmail(email) {
		window.location.href = `mailto:${email}`;
	}
</script>
