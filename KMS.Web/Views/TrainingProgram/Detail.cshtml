@using KMS.Shared.DTOs.TrainingProgram
@using KMS.Web.Common
@using KMS.Web.ViewModels.Shared.Components.Home
@using KMS.Web.Helpers
@using KMS.Web.ViewModels
@model TrainingSections
@using KMS.Web.Common.Lang
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = "Chương trình đào tạo";
    Layout = "~/Pages/Shared/_LayoutPublish.cshtml";
}

@section styles {
    <link rel="stylesheet" href="@ConstLocation.value/css/pages/training-program/style.css" asp-append-version="true" />
    <style>
        .sidebar-menu {
            border-top: 3px solid var(--highlight-color);
            background-color: #fff;
            position: fixed;
            right: -300px;
            bottom: 0;
            height: calc(100dvh + 17px - var(--header-height) - var(--search-bar-height, 0px) - var(--search-bar-margin-bottom, 0px) * 2) !important;
            transition: right 0.3s ease;
            width: 300px;
            z-index: 9999;
        }
    </style>
}

@await Html.PartialAsync("SearchBar/_SearchBarHeaderWrapper")

<div class="training-program__container custom-container">
    <h1 class="training-program__title">@Model.DetailSection[0].name</h1>
    <h3 class="training-program__subtitle">
        Khoa @Model.DetailSection[0].department_id
    </h3>
    @* <hr class="mt-5 mb-5" /> *@
    <table class="mt-5">
        <thead>
            <tr>
                <th style="width:60%">@Localizer["TrainingProgram/Detail.training-program__container.th_ThongTinTaiLieu"]</th>
                <th>@Localizer["TrainingProgram/Detail.training-program__container.th_TacGia"]</th>
                <th>@Localizer["TrainingProgram/Detail.training-program__container.th_GiaoTrinh"]</th>
                <th>@Localizer["TrainingProgram/Detail.training-program__container.th_BatBuoc"]</th>
                <th>@Localizer["TrainingProgram/Detail.training-program__container.th_TuChon"]</th>
            </tr>
        </thead>

        <tbody>
            @{
                var stt = 1;
            }
            @foreach (var item in Model.ListSubject)
            {
                <tr class="training-program__group">
                    <td colspan="14" >
                        @stt. @item.title

                        @if (!string.IsNullOrWhiteSpace(item.bib_publisplace))
                        {
                            <text> - @item.bib_publisplace</text>
                        }

                        @if (!string.IsNullOrWhiteSpace(item.bib_publisher))
                        {
                            <text> : @item.bib_publisher</text>
                        }

                        @if (!string.IsNullOrWhiteSpace(item.bib_yearpub))
                        {
                            <text>, @item.bib_yearpub</text>
                        }
                    </td>
                </tr>
                @foreach (var item_lib in item.ListSubjectLib)
                {
                        <tr>
                        <td class="text-start training-program__code" style="cursor: pointer;" onclick="window.open('@($"{ConstLocation.value}/chi-tiet-tai-lieu/{item_lib.slug}")','_blank')">
                            @item_lib.title

                            @if (!string.IsNullOrWhiteSpace(item_lib.bib_publisplace))
                            {
                                <text> - @item_lib.bib_publisplace</text>
                            }

                            @if (!string.IsNullOrWhiteSpace(item_lib.bib_publisher))
                            {
                                <text> : @item_lib.bib_publisher</text>
                            }

                            @if (!string.IsNullOrWhiteSpace(item_lib.bib_yearpub))
                            {
                                <text>, @item_lib.bib_yearpub</text>
                            }
                        </td>
                        <td class="text-start">@item_lib.bib_author</td>
                        <td class="text-center">@(item_lib.is_included_ref ? "✔" : "")</td>
                        <td class="text-center">@(item_lib.is_mandatory_ref ? "✔" : "")</td>
                        <td class="text-center">@(item_lib.is_optional_ref ? "✔" : "")</td>
                        </tr>
                }
                stt++;
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("FixedCornerButtons/_FixedCornerButtons")
@section scripts {
    <script src="@ConstLocation.value/public/js/@Manifest.get("training_program.js")"></script>
}